# ------------------------------------------------------------------
# CareRelay configuration (copy to .env and fill in). These values are
# surfaced to the Lambdas / AgentCore Runtime as environment variables by
# the CDK compute stack. AWS credential precedence is: AWS_ACCESS_KEY_ID +
# AWS_SECRET_ACCESS_KEY (if both set) -> AWS_PROFILE -> boto3 default
# resolution. See lambdas/common/aws_clients.py.
# ------------------------------------------------------------------

# ---- AWS account / region ------------------------------------------
AWS_REGION=ap-south-1
# Named AWS CLI profile, used only if AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# below are both blank.
AWS_PROFILE=carerelay

# ---- Explicit AWS credentials (local dev only; LEAVE BLANK for Lambda/AgentCore) ----
# Used for every service EXCEPT Bedrock (S3, DynamoDB, SES, Transcribe,
# End User Messaging, KMS).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=   # only needed if using temporary/STS credentials

# ---- SEPARATE credentials for Bedrock only (optional) -----------------
# Only needed if your main account/key above cannot invoke Bedrock models
# (some accounts restrict Bedrock specifically). Leave blank to just use
# the main credentials above for Bedrock too.
BEDROCK_AWS_ACCESS_KEY_ID=
BEDROCK_AWS_SECRET_ACCESS_KEY=
# BEDROCK_AWS_SESSION_TOKEN=   # only needed if using temporary/STS credentials

# ---- Amazon Bedrock (narration/summarization only, never decisioning) ----
# Used ONLY for summarizing symptom notes / drafting messages / extracting
# insurance-card fields. Coverage and approval decisions are made by the
# deterministic rules engine (agent_app/rules_engine.py), never by the model.
# Claude Sonnet 4.6 is natively multimodal, so one model ID covers both roles.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_VISION_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Only set if Bedrock model access was granted in a different region than
# AWS_REGION. Leave blank to just use AWS_REGION.
BEDROCK_REGION=

# ---- Amazon Transcribe (voice notes) ----
# Only set if Transcribe should run in a different region than AWS_REGION.
# (Insurance-card extraction runs on the Bedrock vision model above, not Textract.)
TRANSCRIBE_REGION=

# ---- AWS End User Messaging Social (WhatsApp patient intake) ----
WHATSAPP_PHONE_NUMBER_ID=
META_API_VERSION=v20.0
# Meta App Secret - verifies X-Hub-Signature-256 on the direct API Gateway
# webhook path. Not needed if you only use the SNS event destination path.
META_APP_SECRET=
# Token configured in Meta's webhook setup page (hub.verify_token). Not
# needed for the SNS path.
META_WEBHOOK_VERIFY_TOKEN=

# ---- AWS End User Messaging SMS / RCS (doctor approval card) ----
RCS_AGENT_ID=
RCS_PHONE_NUMBER_ID=
SMS_ORIGINATION_NUMBER=
CLINIC_APPROVER_NUMBERS=

# ---- Amazon SES (signed audit report email + staff onboarding email) ----
# Must be a verified SES identity (email or domain) in AWS_REGION, or
# SendEmail calls (audit report + onboarding email) will fail. See
# scripts/setup_ses_identity.py to verify an email identity via the API.
SES_SENDER=robotoroboto443@gmail.com
SES_COMMAND_RECIPIENTS=robotoroboto443@gmail.com
# SES sandbox safety: redirect ALL outbound email to this one verified
# address until SES production access is granted. Leave blank once granted.
SES_SANDBOX_OVERRIDE_RECIPIENT=robotoroboto443@gmail.com
# Where the formal prior-auth request letter is addressed (payer intake inbox).
PAYER_PRIOR_AUTH_INBOX=priorauth@payer.example.com
# Clinic name shown on the payer request letter.
CLINIC_NAME=Metro Orthopedics & Imaging Center

# ---- AWS KMS (audit report signing) ----
# Leave blank to let CDK create a dedicated signing key.
KMS_SIGNING_KEY_ID=

# ---- Behavior ----
INTAKE_BATCH_WINDOW_SECONDS=15
LOG_LEVEL=INFO
